# Required: Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Set to false so Jarvis performs real code edits & Cloudflare deployments (true = safe simulation)
DRY_RUN=false

# Server Port (default 3000)
PORT=3000

# Live Voice Model & J.A.R.V.I.S. Voice Preset (Charon or Fenrir)
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio
JARVIS_VOICE=Charon

# Twilio Phone Bridge & Outbound Callback Credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+447482775965
MY_PHONE_NUMBER=your_personal_mobile_number_here

# 24/7 Cloud Mode (GitHub Code Editing + Cloudflare Pages Auto-Deploy while PC is OFF)
GITHUB_TOKEN=your_github_personal_access_token_here
COELISAFE_GITHUB_REPO=kovia/Verifiedfor-App
CLOUDFLARE_DEPLOY_HOOK=your_optional_cloudflare_pages_deploy_hook_url
